{
  "name": "online-ink-editor",
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "docs:build": "vite build --outDir docs --base /online-ink-editor/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "all": "npm run lint && npm run test:coverage && npm run test:e2e && npm run build && npm run docs:build"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@mavnn/codemirror-lang-ink": "^0.10.1",
    "@uiw/react-codemirror": "^4.25.12",
    "inkjs": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "baseline-browser-mapping": "^2.11.27",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  }
}
